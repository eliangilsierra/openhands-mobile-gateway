# OpenHands Mobile Gateway — environment configuration.
# Copy to `.env` and fill in the values. `.env` is git-ignored; never commit real secrets.
# `src/config.ts` validates every one of these at boot and exits non-zero on anything invalid.

# Base URL of the agentcanvas service's ingress proxy (architecture §4.1, §14).
# Default when unset: http://agentcanvas:8000 (the Compose service name).
OPENHANDS_BASE_URL=http://agentcanvas:8000

# REQUIRED, no default. Sent as the `X-Session-API-Key` header on every agentcanvas request.
# Must be exactly the same value as agentcanvas's own LOCAL_BACKEND_API_KEY (architecture §4.3).
# Leave empty here; set the real value only in the deployment environment (Coolify), never in git.
OPENHANDS_API_KEY=

# REQUIRED, no default. The Telegram bot token from @BotFather.
# Leave empty here; set the real value only in the deployment environment (Coolify), never in git.
TELEGRAM_BOT_TOKEN=

# REQUIRED, no default. Comma-separated Telegram numeric user ids allowed to use the bot
# (architecture §9.1 B1). At least one id is required; anything else fails to start.
TELEGRAM_ALLOWED_USER_IDS=

# Root directory under which project directories are searched (architecture §7.4).
# Default when unset: /projects (matches agentcanvas's canvas-projects volume mount).
PROJECTS_ROOT=/projects

# Optional, comma-separated static override of the project list (ADR-0005). When unset, the
# Gateway lists subdirectories of PROJECTS_ROOT instead.
#PROJECTS=toneprofiler,code-sentinel

# Path to the Gateway's single SQLite file (ADR-0003).
# Default when unset: /data/gateway.db (matches the gateway-state volume mount).
DATABASE_PATH=/data/gateway.db

# One of: debug, info, warn, error. Default when unset: info.
LOG_LEVEL=info

# TCP port the /health endpoint listens on. Default when unset: 8080. Never published to the
# host or the Internet (NFR-1) — only `expose`d on the Compose network.
HEALTH_PORT=8080

# IANA timezone name. Default when unset: UTC.
TZ=UTC
