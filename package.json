{
  "name": "openhands-mobile-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram gateway for OpenHands agent-canvas conversations.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
